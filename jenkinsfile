pipeline{
    agent any

    stages{
        stage('Checkout code'){
            steps{
                url:'https://github.com/sidda12345/college.git'
            }
        }
        stage('Run Test'){
            steps{
                bat '''
                    call venv\\Scripts\\activate
                    students.py
                    '''
            }
        }
    }
    post{
        success{
            echo "Pipeline success"
        }
        failed{
            echo "Pipeline failed"
        }
        
    }
}